<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the signed COMPAS.app.

  Notarization requires the hardened runtime, and the hardened runtime's
  defaults are fatal to this particular stack:

  - allow-jit / allow-unsigned-executable-memory: librosa pulls in numba,
    which JITs through LLVM. Without both keys the first analysis dies in
    llvmlite with a mach_vm_protect failure.
  - disable-library-validation: PyInstaller loads dozens of .so/.dylib files
    at runtime. They carry our signature rather than being linked at build
    time, and library validation rejects that layout.
  - allow-dyld-environment-variables: the PyInstaller bootloader sets
    DYLD_LIBRARY_PATH for the collected frameworks.

  Each key here is an exception Apple's notary service accepts but that also
  widens the app's attack surface, so this list stays minimal on purpose.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
</dict>
</plist>
